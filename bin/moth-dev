#!/bin/sh
# moth, straight from source: reflects uncommitted changes, no build step.
# Resolves its own location so it works when symlinked onto PATH.
target=$0
while [ -L "$target" ]; do
  dir=$(cd -P "$(dirname "$target")" && pwd)
  target=$(readlink "$target")
  case $target in
    /*) ;;
    *) target="$dir/$target" ;;
  esac
done
dir=$(cd -P "$(dirname "$target")" && pwd)
exec bun "$dir/../src/cli.ts" "$@"
