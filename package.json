{
  "name": "moth",
  "version": "0.2.0",
  "description": "An opinionated issue tracker that lives in your repo. Tickets are markdown files with an enforced schema.",
  "keywords": [
    "issue-tracker",
    "cli",
    "tickets",
    "markdown",
    "agents"
  ],
  "homepage": "https://github.com/nikolasgioannou/moth",
  "bugs": {
    "url": "https://github.com/nikolasgioannou/moth/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolasgioannou/moth.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "moth": "./dist/moth"
  },
  "scripts": {
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "prepare": "lefthook install",
    "moth": "bun src/cli.ts",
    "build:release": "bun run scripts/release-build.ts",
    "build:npm": "bun run scripts/npm-packages.ts",
    "formula": "bun run scripts/homebrew-formula.ts",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.12"
  }
}
